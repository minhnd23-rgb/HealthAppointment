<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- Đăng xuất: về Login và xóa toàn bộ back stack -->
    <action
        android:id="@+id/action_global_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.healthappointment.ui.auth.LoginFragment"
        android:label="Đăng nhập"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_patientHome"
            app:destination="@id/patientHomeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_login_to_staffHome"
            app:destination="@id/staffHomeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.healthappointment.ui.auth.RegisterFragment"
        android:label="Đăng ký"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_register_to_patientHome"
            app:destination="@id/patientHomeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/patientHomeFragment"
        android:name="com.example.healthappointment.ui.patient.PatientHomeFragment"
        android:label="Bệnh nhân"
        tools:layout="@layout/fragment_patient_home" />

    <fragment
        android:id="@+id/staffHomeFragment"
        android:name="com.example.healthappointment.ui.staff.StaffHomeFragment"
        android:label="Nhân viên"
        tools:layout="@layout/fragment_staff_home" />
</navigation>